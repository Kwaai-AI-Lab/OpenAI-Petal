# Use a minimal Python image
FROM python:3.10-slim

LABEL org.opencontainers.image.title="KwaaiNet Health Check Website" \
      org.opencontainers.image.description="KwaaiNet Health Check Website" \      
      org.opencontainers.image.authors="contact@kwaai.ai" 

LABEL maintainer="Kwaai Labs<contact@kwaai.ai>"  

# Set the working directory
WORKDIR /app

# Install system dependencies
RUN apt update && apt install -y libopenblas-dev ninja-build build-essential wget git
RUN python -m pip install --upgrade pip pytest cmake scikit-build setuptools


# Clone health service repository, pinned so the patches below apply against a
# known revision rather than a moving target.
ARG HEALTH_SERVICE_REF=30d00fb644a0b1333e37278d43735b29623f9932
RUN git clone https://github.com/petals-infra/health.petals.dev /app/health_service \
    && git -C /app/health_service checkout --quiet "${HEALTH_SERVICE_REF}"

# Apply local patches in quilt series order. Each is applied with `git apply`
# (no fuzz), so a patch that no longer matches upstream fails the build loudly
# instead of being silently skipped.
COPY docker/kwaainet_health/patches /app/patches
RUN while IFS= read -r p; do \
        case "$p" in ''|\#*) continue ;; esac; \
        echo "Applying patch: $p"; \
        git -C /app/health_service apply --verbose "/app/patches/$p" || exit 1; \
    done < /app/patches/series

# Copy your custom requirements file with pinned versions
COPY docker/kwaainet_health/requirements.txt /app/health_service/requirements.txt

# Install dependencies from health service
WORKDIR /app/health_service
RUN pip install --no-cache-dir -r requirements.txt --upgrade pip

# Copy entrypoint script
COPY docker/kwaainet_health/entrypoint.sh /app/entrypoint.sh
# Patch p2p utils for async timeout call.
COPY docker/kwaainet_health/p2p_utils.py /app/health_service/p2p_utils.py
COPY docker/kwaainet_health/kwaainet.html /app/health_service/templates/index.html

# Ensure script is executable
RUN chmod +x /app/entrypoint.sh

# Expose Health API port
EXPOSE 8000
ENV PETALS_IGNORE_DEPENDENCY_VERSION=1

ENV INITIAL_PEERS=${INITIAL_PEERS:-"/dns/bootstrap-1.kwaai.ai/tcp/8000/p2p/QmQhRuheeCLEsVD3RsnknM75gPDDqxAb8DhnWgro7KhaJc,/dns/bootstrap-2.kwaai.ai/tcp/8000/p2p/Qmd3A8N5aQBATe2SYvNikaeCS9CAKN4E86jdCPacZ6RZJY"}
# Set the entrypoint
ENTRYPOINT ["/app/entrypoint.sh"]
