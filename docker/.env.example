# KwaaiNet Docker Environment Configuration
# Copy this file to .env and customize for your deployment

# Public IP address - REQUIRED for node visibility on network map
# Find your public IP: curl ifconfig.me
# Uncomment and set your server's public IP:
# PUBLIC_IP=1.2.3.4

# Public name - identifies your node on the network map
# Format: username_docker@kwaai (distinguishes Docker from bare-metal)
# Examples: alice_docker@kwaai, bob_docker@kwaai, server1_docker@kwaai
# If not set, defaults to: anonymous_docker@kwaai
# PUBLIC_NAME=yourname_docker@kwaai

# Optional: Number of model blocks to serve (node only)
# Adjust based on available VRAM:
#   2 blocks  ≈ 2-4GB VRAM
#   4 blocks  ≈ 4-8GB VRAM
#   8 blocks  ≈ 8-16GB VRAM
#   16 blocks ≈ 16-32GB VRAM
#   32 blocks ≈ 32-48GB VRAM (full model)
# KWAAINET_BLOCKS=4
