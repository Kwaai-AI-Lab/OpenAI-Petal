# Use a minimal Python image
FROM python:3.10-slim

LABEL org.opencontainers.image.title="KwaaiNet Health Check Website - Local Development" \
      org.opencontainers.image.description="KwaaiNet Health Check Website for localhost testing" \
      org.opencontainers.image.authors="contact@kwaai.ai"

LABEL maintainer="Kwaai Labs<contact@kwaai.ai>"

# Set the working directory
WORKDIR /app

# Install system dependencies
RUN apt update && apt install -y libopenblas-dev ninja-build build-essential wget git
RUN python -m pip install --upgrade pip pytest cmake scikit-build setuptools

# Clone health service repository
RUN git clone https://github.com/petals-infra/health.petals.dev /app/health_service

# Copy custom requirements file with pinned versions
COPY docker/kwaainet_health_local/requirements-local.txt /app/health_service/requirements.txt

# Install dependencies from health service
WORKDIR /app/health_service
RUN pip install --no-cache-dir -r requirements.txt --upgrade pip

# Copy entrypoint script for local development
COPY docker/kwaainet_health_local/entrypoint-local.sh /app/entrypoint.sh
# Copy simple Flask app for local testing
COPY docker/kwaainet_health_local/simple_app.py /app/simple_app.py
# Use local development HTML template
COPY docker/kwaainet_health_local/kwaainet-local.html /app/health_service/templates/index.html

# Ensure script is executable
RUN chmod +x /app/entrypoint.sh

# Create logs directory
RUN mkdir -p /app/logs

# Expose Health API port
EXPOSE 8000
ENV PETALS_IGNORE_DEPENDENCY_VERSION=1

# Default to localhost peers for development
ENV INITIAL_PEERS=${INITIAL_PEERS:-"/ip4/127.0.0.1/tcp/8000/p2p/QmLocalPeer1,/ip4/127.0.0.1/tcp/8001/p2p/QmLocalPeer2"}

# Set the entrypoint
ENTRYPOINT ["/app/entrypoint.sh"]